  InputLines:
    - '// @input SceneObject visualRoot {"hint":"Child holding the Core and Glow shells. Scaled by the orb animation."}'
    - '// @input Component.RenderMeshVisual core {"hint":"Inner sphere carrying the note colour and fresnel rim."}'
    - '// @input Component.RenderMeshVisual glow {"hint":"Outer sphere carrying the glow halo."}'
    - '// @input Component.Text transcriptText {"hint":"Text panel showing the transcript. Optional."}'
    - '// @input SceneObject transcriptPanel {"hint":"Object holding the transcript panel. Shown while recording, then only when the orb is clicked."}'
    - '// @input SceneObject infoPanel {"hint":"Panel with the countdown and the Done button. Shown only while the orb is selected."}'
    - '// @input Component.Text timeLabel {"hint":"Label showing how long is left before the reminder."}'
    - '// @input AssignableType_1 doneButton {"hint":"Interactable that deletes / completes this note."}'
    - '// @input SceneObject doneButtonRoot {"hint":"Object holding the Done button, used as its hit target and hover visual."}'
    - '// @input Component.MaterialMeshVisual donePlate {"hint":"Plate behind the Done label, tinted and scaled on hover."}'
    - '// @input vec4 doneIdleColor = {0.12,0.16,0.24,0.85} {"hint":"Done button colour when idle.", "widget":"color"}'
    - '// @input vec4 doneHoverColor = {0.3,0.55,0.95,0.95} {"hint":"Done button colour while hovered.", "widget":"color"}'
    - '// @input float doneHoverScale = 1.12 {"hint":"Done button scale multiplier while hovered.", "widget":"slider", "min":1, "max":1.5, "step":0.01}'
    - "// @input float doneClickRadius = 4.5 {\"hint\":\"Radius of the Done button's hit target, in centimetres. Match it to the plate width so the button is as easy to hit as it looks.\", \"widget\":\"slider\", \"min\":1, \"max\":12, \"step\":0.5}"
    - '// @ui {"widget":"separator"}'
    - '// @input bool billboardPanels = true {"hint":"Keep the transcript and info panels turned toward the user."}'
    - '// @input AssignableType_2 interactable {"hint":"Interactable that makes the orb clickable. Defaults to one on this object."}'
    - "// @input float clickRadius = 3.6 {\"hint\":\"Radius of the click target, in centimetres. Should roughly match the orb's own size.\", \"widget\":\"slider\", \"min\":1, \"max\":20, \"step\":0.5}"
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Hover feedback"}'
    - '// @input float hoverEmissionBoost = 1.1 {"hint":"Extra emission while the pointer is over the orb, so it reads as clickable.", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input float hoverScaleBoost = 0.25 {"hint":"Extra size while hovered, as a fraction of the orb radius.", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
    - '// @input bool logHover {"hint":"Print hover enter/exit to the log. Development aid only."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Orb form"}'
    - '// @input float baseRadius = 3 {"hint":"Resting radius of the orb, in centimetres.", "widget":"slider", "min":0.5, "max":20, "step":0.5}'
    - '// @input float recordingScaleBoost = 0.85 {"hint":"Extra radius at full mic amplitude while recording.", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Glow and rim"}'
    - '// @input float rimIntensity = 2 {"hint":"Emission strength of the rim highlight.", "widget":"slider", "min":0, "max":10, "step":0.1}'
    - '// @input float rimExponent = 2.2 {"hint":"Fresnel falloff power. Higher values give a tighter rim.", "widget":"slider", "min":0, "max":10, "step":0.1}'
    - '// @input float glowDistance = 0.28 {"hint":"How far the outer glow reaches past the core. Keep low so the halo stays behind the core.", "widget":"slider", "min":0, "max":10, "step":0.05}'
    - '// @input float glowFalloff = 7 {"hint":"Outer glow falloff. Higher is a softer, smoother fade.", "widget":"slider", "min":0, "max":10, "step":0.1}'
    - '// @input float glowIntensityScale = 0.35 {"hint":"Overall glow strength relative to the core. Below 1 keeps the core and inner shell dominant.", "widget":"slider", "min":0, "max":2, "step":0.01}'
    - '// @input bool glowEnabled = true {"hint":"Turn the outer glow off entirely. The orb reads well without it."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Noise"}'
    - '// @input float noiseScale = 1.6 {"hint":"Amplitude of the organic wobble applied to shape and glow.", "widget":"slider", "min":0, "max":8, "step":0.1}'
    - '// @input float noiseSpeed = 0.7 {"hint":"Rate of the noise animation.", "widget":"slider", "min":0, "max":5, "step":0.05}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Displaced geometry"}'
    - '// @input bool useDisplacedMesh = true {"hint":"Replace the smooth spheres with noise-displaced meshes. This is what makes the orb read as 3D."}'
    - '// @input float meshSubdivisions = 3 {"hint":"Icosphere subdivisions. 2 is 162 verts, 3 is 642. Higher is smoother and costlier.", "widget":"slider", "min":0, "max":4, "step":1}'
    - '// @input float meshNoiseScale = 1.9 {"hint":"Spatial frequency of the displacement noise. Higher gives finer detail.", "widget":"slider", "min":0.2, "max":8, "step":0.1}'
    - '// @input float meshOctaves = 4 {"hint":"Fbm octaves in the displacement.", "widget":"slider", "min":1, "max":6, "step":1}'
    - '// @input float meshAmplitude = 0.22 {"hint":"Displacement depth as a fraction of radius. 0 is a smooth sphere.", "widget":"slider", "min":0, "max":0.6, "step":0.01}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Inner shell"}'
    - '// @input Component.RenderMeshVisual innerVisual {"hint":"Second displaced shell that counter-rotates inside the core, for parallax depth."}'
    - '// @input float innerScale = 0.74 {"hint":"Inner shell radius, as a fraction of the core.", "widget":"slider", "min":0.2, "max":1, "step":0.01}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Rotation"}'
    - '// @input float coreSpinSpeed = 9 {"hint":"Core rotation speed in degrees/second. Rotation is only visible once the mesh is displaced.", "widget":"slider", "min":0, "max":90, "step":1}'
    - '// @input float innerSpinSpeed = -14 {"hint":"Inner shell rotation speed in degrees/second. Opposite sign reads as depth.", "widget":"slider", "min":-90, "max":90, "step":1}'
    - '// @input float recordingSpinBoost = 2.5 {"hint":"Extra spin multiplier at full mic amplitude while recording.", "widget":"slider", "min":0, "max":4, "step":0.1}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Audio reactivity"}'
    - "// @input float audioSensitivity = 1.3 {\"hint\":\"Multiplier applied to mic amplitude while recording. Combined with NoteManager's own multiplier; too high pins the level at maximum and the orb stops varying.\", \"widget\":\"slider\", \"min\":0, \"max\":8, \"step\":0.1}"
    - '// @input float audioEmissionResponse = 2.6 {"hint":"How much mic amplitude drives emission while recording.", "widget":"slider", "min":0, "max":6, "step":0.1}'
    - '// @input float audioFollowRate = 22 {"hint":"How quickly the orb follows the mic. Higher is snappier.", "widget":"slider", "min":1, "max":40, "step":1}'
    - '// @input float audioIdleLevel = 0.12 {"hint":"Minimum audio level while recording, so a silent orb still reads as live. Keep low or there is no headroom left for speech to show.", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Pulse"}'
    - '// @input float basePulseHz = 0.25 {"hint":"Glow pulse rate, in Hz, for a note that is not yet urgent.", "widget":"slider", "min":0, "max":4, "step":0.05}'
    - '// @input float urgentPulseHz = 1.4 {"hint":"Glow pulse rate, in Hz, for a note that is due now.", "widget":"slider", "min":0, "max":4, "step":0.05}'
